rules_version = '2';

// AI 대시보드 Firestore 보안 규칙 (프로젝트 aidash-d831b)
//
// 배포:  firebase deploy --only firestore:rules
// 또는:  Firebase 콘솔 → Firestore Database → 규칙 탭에 붙여넣기
//
// ─────────────────────────────────────────────────────────────
// Firestore 규칙은 OR 로 동작합니다. 어느 한 match 가 허용하면 통과합니다.
// 따라서 allow ...: if false 를 덧붙여도 다른 match 의 허용을 취소하지 못합니다.
// 무언가를 실제로 막으려면 그것을 허용하던 match 를 지우거나 좁혀야 합니다.
//
// 2026-09-08 정리:
//   udb / signals / trades / portfolio / daily / holdings / config 규칙을 제거했습니다.
//   SMARTSWING_NH 앱이 쓰던 자리인데 전부 문서 0개였고, 해당 앱은 더 이상 쓰지 않습니다.
//   config/github 에 있던 GitHub PAT(2026-04-21 만료)도 함께 삭제했습니다.
//   이제 이 프로젝트에서 쓰는 경로는 dashboard 뿐입니다.
//
// App Check (다음 단계)
//   콘솔 → App Check 에서 reCAPTCHA v3 로 웹 앱을 등록하고, 사이트 키를
//   .env 의 VITE_RECAPTCHA_SITE_KEY 에 넣어 배포한 뒤 Firestore 적용을 켭니다.
//   그 다음 아래 조건들에 `request.app != null &&` 를 덧붙이면
//   배포된 앱에서 온 요청만 통과합니다.
//   ⚠️ 순서를 지키세요. 적용을 켜기 전에 조건을 켜면 앱이 즉시 멈춥니다.
// ─────────────────────────────────────────────────────────────

service cloud.firestore {
  match /databases/{database}/documents {

    match /dashboard/data {
      allow read: if true;

      // 생성과 삭제를 원천 차단한다.
      // 2026-09-07 전체 소실은 "문서가 없다"는 클라이언트의 오판에서 시작됐다.
      // 이 문서는 콘솔에서만 만들고 지운다.
      allow create: if false;
      allow delete: if false;

      // companies 외의 필드가 끼어들지 못하게 하고,
      // 업체가 한 번에 2개 이상 사라지는 저장은 거부한다. 정상적인 1개씩 삭제는 통과.
      allow update: if request.resource.data.keys().hasOnly(['companies'])
        && request.resource.data.companies is list
        && request.resource.data.companies.size() > 0
        && request.resource.data.companies.size() >= resource.data.companies.size() - 1;
    }

    // 관리자 비밀번호 해시 (PBKDF2 + 솔트)
    // 클라이언트가 검증하려면 읽어야 하므로 읽기를 막을 수 없다.
    match /dashboard/config {
      allow read: if true;
      allow write: if request.resource.data.keys().hasOnly([
        'adminPasswordHash', 'adminPasswordSalt', 'adminPasswordIterations', 'updatedAt'
      ]);
    }
  }
}
